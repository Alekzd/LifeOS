# Environment Variables — Life OS
# ============================================================
# SAO CHÉP FILE NÀY THÀNH .env.local VÀ ĐIỀN GIÁ TRỊ THẬT
# KHÔNG BAO GIỜ COMMIT .env.local LÊN GIT!
# ============================================================

# ── CLERK AUTHENTICATION ──────────────────────────────────
# Lấy từ: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Chỉ dùng trong server-side / Convex env
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_HERE

# ── CONVEX BACKEND ────────────────────────────────────────
# Lấy từ: npx convex dev (tự động điền vào .env.local)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Dùng để deploy Convex lên production
CONVEX_DEPLOY_KEY=prod:YOUR_DEPLOY_KEY

# ── CONVEX ENVIRONMENT SECRETS ───────────────────────────
# Set bằng lệnh: npx convex env set KEY value
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_YOUR_SECRET
# ADMIN_EMAIL=your-email@example.com

# ── APP CONFIG ────────────────────────────────────────────
# URL của app khi deploy lên Cloudflare Pages
NEXT_PUBLIC_APP_URL=https://life-os.pages.dev
